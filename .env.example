APP_ENV=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/sports
AI_PROVIDER=groq
OPENAI_API_KEY=
OPENAI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_ID=
NEWS_FETCH_INTERVAL_MINUTES=5
NEWS_INITIAL_LOOKBACK_HOURS=24
MAX_POST_LENGTH=260
HTTP_TIMEOUT_SECONDS=15
EXTERNAL_API_MAX_RETRIES=3
LOG_LEVEL=INFO
SCHEDULER_ENABLED=true
TELEGRAM_ENABLED=true
