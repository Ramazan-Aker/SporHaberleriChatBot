APP_ENV=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/sports

# Runtime
SCHEDULER_ENABLED=true
TELEGRAM_ENABLED=true
PRICE_CHECK_INTERVAL_MINUTES=15
PRICE_SNAPSHOT_INTERVAL_HOURS=24

# Stores
ENABLE_AMAZON=true
ENABLE_TRENDYOL=false
ENABLE_HEPSIBURADA=false
USE_MOCK_STORE_DATA=true
ACTIVE_PRODUCT_CATEGORIES=SSD,RAM,GPU,CPU,Laptop,Monitor,Headphones,Smartphone,Smartwatch,Gamepad,Console,Gaming Accessories

# Amazon Creators API (production)
AMAZON_CREDENTIAL_ID=
AMAZON_CREDENTIAL_SECRET=
AMAZON_PARTNER_TAG=
AMAZON_MARKETPLACE=www.amazon.com.tr
AMAZON_ASINS=
AMAZON_SEARCH_KEYWORDS=
AMAZON_REQUESTS_PER_SECOND=1

# Deprecated PA-API names, retained only for configuration compatibility.
# They are not accepted by the current Creators API adapter.
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=

# Opportunity
MIN_OPPORTUNITY_SCORE=75
OPPORTUNITY_COOLDOWN_HOURS=24
SCORE_PRICE_DROP_WEIGHT=30
SCORE_HISTORICAL_LOW_WEIGHT=25
SCORE_POPULARITY_WEIGHT=15
SCORE_SELLER_WEIGHT=15
SCORE_STOCK_WEIGHT=10
SCORE_SAVINGS_WEIGHT=5

# Affiliate
AFFILIATE_DISCLOSURE="#reklam"

# Optional AI name polish; false keeps the entire price pipeline deterministic.
ENABLE_AI_POST_POLISH=false
AI_PROVIDER=groq
OPENAI_API_KEY=
OPENAI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_REASONING_EFFORT=low
GROQ_MAX_COMPLETION_TOKENS=512
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_ID=
# Legacy sports settings are retained for old deployments/data only. No RSS job runs.
NEWS_FETCH_INTERVAL_MINUTES=5
NEWS_INITIAL_LOOKBACK_HOURS=24
NEWS_ONLY_CURRENT_DAY=true
NEWS_TIMEZONE=Europe/Istanbul
ENFORCE_SOURCE_USAGE_POLICY=true
ENABLE_SOURCE_POLICY_CHECK=true
MAX_POST_LENGTH=260
MAX_SOURCE_SIMILARITY=0.55
ALLOW_EXTERNAL_MEDIA=false
ALLOW_DIRECT_QUOTES=false
ENABLE_CLAIM_VALIDATION=true
HTTP_TIMEOUT_SECONDS=15
EXTERNAL_API_MAX_RETRIES=3
AI_MIN_REQUEST_INTERVAL_SECONDS=12
AI_FAILED_RETRY_LIMIT=5
LOG_LEVEL=INFO
